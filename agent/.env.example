# copy to agent/.env.local

# livekit cloud project (cloud.livekit.io → settings → keys). also pays for the llm via livekit inference
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# sarvam (dashboard.sarvam.ai) for speech-to-text, and the voice when TTS_PROVIDER=sarvam
SARVAM_API_KEY=

# teacher voice: elevenlabs (paid plan needed for indian library voices) or sarvam
TTS_PROVIDER=sarvam
ELEVEN_API_KEY=
# ELEVEN_MODEL=eleven_v4_turbo
# ELEVEN_VOICE=a6XidOEnTywSiWFoBUhm
# TTS_MODEL=bulbul:v4-flash
# TTS_SPEAKER=simran_enhi_companion

# the web app that stores progress, memory and alerts, and the shared secret for it
WEB_URL=http://localhost:3000
AGENT_SECRET=change-me

# optional overrides. a "provider/model" name goes through livekit inference;
# a bare gemini name (like gemini-3.5-flash) uses GOOGLE_API_KEY directly
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_FALLBACK=google/gemini-2.5-flash
# SIDE_MODEL=openai/gpt-4.1-mini
# GOOGLE_API_KEY=
# STT_MODEL=saaras:v4
# STT_MODE=translit

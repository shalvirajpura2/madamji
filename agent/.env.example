# copy to agent/.env.local

# livekit cloud project (cloud.livekit.io → settings → keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# sarvam (dashboard.sarvam.ai) for speech-to-text and the teacher's voice
SARVAM_API_KEY=

# gemini (aistudio.google.com/apikey) for the teacher llm, answer judge and safety check
GOOGLE_API_KEY=

# the web app that stores progress, memory and alerts, and the shared secret for it
WEB_URL=http://localhost:3000
AGENT_SECRET=change-me

# optional overrides
# LLM_MODEL=gemini-3.5-flash
# SIDE_MODEL=gemini-3.5-flash-lite
# TTS_MODEL=bulbul:v4-flash
# TTS_SPEAKER=simran_enhi_companion
# STT_MODEL=saaras:v4
# STT_MODE=translit

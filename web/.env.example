# copy to web/.env.local

# livekit cloud project, same as the agent
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# must match AGENT_SECRET in agent/.env.local
AGENT_SECRET=change-me

# passcode for /staff (safety alerts dashboard)
STAFF_PASSCODE=change-me-too

# optional: supabase for memory, progress and alerts. without it, data goes to web/.data/store.json
# (fine locally, but vercel needs supabase). run web/supabase/schema.sql once.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# google sign-in through supabase auth (same project as above). in supabase: authentication -> providers -> google.
# use the publishable (or legacy anon) key, never the service role key. without these, sign-in is off and
# local dev falls back to a name saved on the device; production refuses to start classes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# free trial per google account and anti-spam limits (these are the defaults)
# TRIAL_LONG_CLASSES=1
# TRIAL_SHORT_CLASSES=2
# CLASSES_PER_IP_PER_DAY=10
# CLASS_STARTS_PER_IP_PER_HOUR=10
# CLASS_STARTS_PER_USER_PER_HOUR=8
